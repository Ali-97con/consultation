{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["crm.html", "splash.html", "login.html", "dashboard.html", "splash.jsx", "assets/**", "*.png", "*.jpg", "*.ico"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
